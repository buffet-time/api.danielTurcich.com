{
	"name": "danielturichdotcomapi",
	"version": "1.0.0",
	"private": true,
	"description": "API for danielTurcich.com",
	"author": {
		"name": "Daniel Turcich",
		"email": "packagejson@danielTurcich.com",
		"url": "https://danielTurcich.com"
	},
	"source": "src/main.ts",
	"type": "module",
	"module": "dist/module.js",
	"scripts": {
		"serve": "pnpm build && pnpm start",
		"start": "node ./dist/module.js",
		"build": "parcel build --no-source-maps",
		"lint:check": "oxlint && echo lint:check done",
		"format:fix": "oxfmt",
		"format:check": "oxfmt --check",
		"build:check": "pnpm build && echo build:check done",
		"checks": "pnpm lint:check && pnpm format:check && pnpm build",
		"prepare": "husky"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/type-provider-json-schema-to-ts": "^5.0.0",
		"@google-cloud/local-auth": "^3.0.1",
		"fastify": "^5.8.5",
		"google-auth-library": "^10.6.2",
		"googleapis": "^171.4.0"
	},
	"devDependencies": {
		"@parcel/config-default": "^2.16.4",
		"@types/node": "^25.8.0",
		"googleapis-common": "^8.0.1",
		"husky": "^9.1.7",
		"oxfmt": "^0.49.0",
		"oxlint": "^1.64.0",
		"parcel": "^2.16.4",
		"typescript": "^6.0.3",
		"undici": "^8.3.0"
	},
	"engines": {
		"node": "^26.1.0",
		"pnpm": "^11.1.2"
	},
	"engineStrict": true,
	"packageManager": "pnpm@11.1.2"
}
